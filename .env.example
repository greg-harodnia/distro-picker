# Copy to `.env.local` for local development, and set the same variable in the
# Vercel project settings. It is read at build time by `$env/static/public`
# (client bundle) and by the `%sveltekit.env.PUBLIC_SUPABASE_URL%` placeholders
# in `src/app.html` (CSP `connect-src` + preconnect).
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
